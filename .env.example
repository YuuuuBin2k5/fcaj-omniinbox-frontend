# true = chạy local bằng mockBackend (không cần AWS); false = kết nối AWS thật
VITE_USE_MOCK=true

# Do Vi / Hoài Nam / Duy bàn giao (Cognito: Ngày 3; REST/WS: Ngày 4-6)
VITE_REST_API_URL=https://xxxxxx.execute-api.ap-southeast-1.amazonaws.com/prod
VITE_WS_URL=wss://yyyyyy.execute-api.ap-southeast-1.amazonaws.com/prod
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Để trống (gửi ID token thẳng) hoặc "Bearer " tùy cấu hình API Gateway Authorizer
VITE_AUTH_HEADER_PREFIX=

# Tùy chọn bảo mật nâng cao: "true" nếu API Gateway gắn Cognito Authorizer cho /simulator/webhook/{channel}
VITE_SIMULATOR_WEBHOOK_AUTH=false

# Pha 2 (tùy chọn): bật nút AI khi Duy đã deploy omni-ai-suggester (Go/No-Go Ngày 9)
VITE_ENABLE_AI=false

# Chỉ bật khi quay/chụp bài test DLQ (backend cũng phải bật ENABLE_FAULT_INJECTION)
VITE_ENABLE_FAULT_UI=false

# Danh sách nhân viên cho dropdown phân công (khớp định danh JWT trong Cognito)
VITE_AGENT_LIST=agent.minh@omniinbox.local,agent.lan@omniinbox.local,agent.tuan@omniinbox.local
